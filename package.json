{
  "name": "cs2go",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "test": "turbo run test",
    "test:browser": "turbo run test:browser",
    "check": "oxfmt --check . && oxlint scripts packages/assets && turbo run check",
    "assets:prepare": "bun run --cwd packages/assets generate",
    "assets:verify": "bun run --cwd packages/assets verify",
    "assets:sync": "bun run --cwd packages/assets sync",
    "test:tools": "vitest run",
    "format": "oxfmt ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "meshoptimizer": "1.3.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "turbo": "^2.11.13",
    "vitest": "^5.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "latest",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.4.5",
  "patchedDependencies": {
    "three@0.187.0": "patches/three@0.187.0.patch"
  }
}
